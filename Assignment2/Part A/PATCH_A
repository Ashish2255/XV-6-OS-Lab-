+/* Generates an unbiased random number in the range [0, numtickets) */
+unsigned random_in_range(unsigned numtickets) {
+    unsigned x;
+    unsigned limit = RANDOM_MAX - (RANDOM_MAX % numtickets);
+
+    // Rejection sampling to remove bias
+    do {
+        x = next_random();
+    } while (x >= limit);
+
+    return x % numtickets;
+}
